# Maintainer: xenoz <https://github.com/sreevarshan-xenoz>
pkgname=friday-mobile
pkgver=0.11.0
pkgrel=1
pkgdesc="Your Linux or Windows desktop on your Android phone: screen, input, clipboard, files and notifications over LAN, Tailscale or the internet"
arch=('x86_64')
url="https://github.com/sreevarshan-xenoz/friday-mobile"
license=('MIT OR Apache-2.0')
# The libraries the binaries link to (the .deb's Depends, and namcap's check).
depends=('ffmpeg' 'glibc' 'hicolor-icon-theme' 'libgcc' 'libpipewire' 'libxcb' 'mesa' 'opus')
optdepends=(
  'pipewire: screen capture through the portal, and sound'
  'xdg-desktop-portal: screen capture on GNOME and KDE'
  'wl-clipboard: the clipboard on Wayland'
  'xclip: the clipboard on X11'
  'playerctl: what is playing, and Play/Pause and skip from the phone'
  'tailscale: reaching the computer through a tailnet'
)
makedepends=('cargo' 'clang' 'cmake' 'libglvnd' 'pkgconf' 'wayland')
install=friday-mobile.install
# makepkg's LTO turns ring's and aws-lc's C into GCC bitcode that the Rust
# link cannot read (undefined ring_core_* symbols).
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('a7374e01f466b7116f831f30b3133936a3ae81a4c75afbafbd15f27801acf64e')

# GitHub names the unpacked folder after the repository, not the package.
_src="friday-mobile-${pkgver}"

prepare() {
  cd "${_src}"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_src}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Two builds, as the release does, so the server's zbus features are not
  # unified into the desktop app's.
  cargo build --frozen --release --bin friday-mobile --bin friday-mobile-pam-ask
  cargo build --frozen --release -p friday-mobile-desktop --bin friday-mobile-app --bin friday-mobile-tray
}

package() {
  cd "${_src}"
  for bin in friday-mobile friday-mobile-app friday-mobile-tray; do
    install -Dm755 "target/release/${bin}" "${pkgdir}/usr/bin/${bin}"
  done
  # "Approve with my phone": PAM's helper, root's. Unused until the owner
  # adds its line to /etc/pam.d; the package never touches PAM.
  install -Dm755 target/release/friday-mobile-pam-ask "${pkgdir}/usr/lib/friday-mobile/friday-mobile-pam-ask"
  # Session-bound USER unit: each user can `systemctl --user enable --now
  # friday-mobile` from their desktop session.
  install -dm755 "${pkgdir}/usr/lib/systemd/user"
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/friday-mobile start|' friday-mobile.service \
    > "${pkgdir}/usr/lib/systemd/user/friday-mobile.service"
  chmod 644 "${pkgdir}/usr/lib/systemd/user/friday-mobile.service"
  install -Dm644 packaging/linux/dev.friday.Mobile.desktop \
    "${pkgdir}/usr/share/applications/dev.friday.Mobile.desktop"
  install -Dm644 assets/brand/friday/friday-512.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/dev.friday.Mobile.png"
  install -Dm644 assets/brand/friday/friday.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dev.friday.Mobile.svg"
  install -Dm644 man/friday-mobile.1 "${pkgdir}/usr/share/man/man1/friday-mobile.1"
  for file in README.md SECURITY.md config.toml.example; do
    install -Dm644 "${file}" "${pkgdir}/usr/share/doc/${pkgname}/${file}"
  done
  install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
