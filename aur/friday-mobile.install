post_install() {
  echo ">>> Start FRIDAY Mobile now and at every sign-in:"
  echo ">>>   systemctl --user enable --now friday-mobile"
  echo ">>> Then open FRIDAY Mobile from the app menu and pair your phone from its Pair page."
}

post_upgrade() {
  echo ">>> Restart the server to run the new version:"
  echo ">>>   systemctl --user restart friday-mobile"
}
